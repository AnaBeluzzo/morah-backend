  "restricoes": [
    {
      "id": "C1",
      "expr": "PerfilProprietario ⇒ PerfilMorador",
      "por_que": "Proprietário é cumulativo a morador: tem tudo o que o morador tem (regra de RBAC do contrato)."
    },
    {
      "id": "C2",
      "expr": "Inquilinos ⇒ (PerfilProprietario ∧ Email)",
      "por_que": "Só o proprietário cadastra inquilino, e o convite de acesso vai por e-mail."
    },
    {
      "id": "C3",
      "expr": "ModuloPortaria ⇒ PerfilPortaria",
      "por_que": "Sem o perfil portaria ninguém registraria visitantes."
    },
    {
      "id": "C4",
      "expr": "Encomendas ⇒ PerfilPortaria",
      "por_que": "Quem recebe e entrega os pacotes é a portaria."
    },
    {
      "id": "C5",
      "expr": "Vistoria ⇒ PerfilPortaria",
      "por_que": "A vistoria da área comum é registrada pela portaria."
    },
    {
      "id": "C6",
      "expr": "Webhook ⇒ PIX",
      "por_que": "O webhook do gateway confirma pagamentos PIX; sem PIX ele não tem o que receber."
    },
    {
      "id": "C7",
      "expr": "(Inadimplencia ∨ SolicitacaoVinculo) ⇒ PerfilSindico",
      "por_que": "Relatório de inadimplência e aprovação de vínculos são tarefas do síndico."
    },
    {
      "id": "C8",
      "expr": "ModulosAtivaveis ⇒ PerfilSindico",
      "por_que": "Só o síndico liga e desliga módulos; como ModulosAtivaveis é obrigatória, todo produto tem síndico."
    },
    {
      "id": "C9",
      "expr": "TaxaDeReserva ⇒ Financeiro",
      "por_que": "Cobrar a reserva gera cobrança, que só existe com o módulo financeiro."
    },
    {
      "id": "C10",
      "expr": "MultiplasInstancias ⇒ ¬SQLite",
      "por_que": "SQLite é um arquivo local com um escritor por vez: não serve para várias instâncias."
    },
    {
      "id": "C11",
      "expr": "AutorizacaoTerceiro ⇒ (PerfilMorador ∧ PerfilPortaria)",
      "por_que": "O morador autoriza o terceiro e a portaria confere o código na retirada."
    },
    {
      "id": "C12",
      "expr": "TelaInicial ⇒ (Financeiro ∨ ModuloPortaria ∨ Avisos ∨ Reservas ∨ MinhaUnidade ∨ Encomendas)",
      "por_que": "O painel mostra dados dos módulos: sem nenhum módulo ativo ele ficaria vazio."
    },
    {
      "id": "C13",
      "expr": "Veiculos ⇒ (PerfilMorador ∨ PerfilProprietario)",
      "por_que": "Veículos são cadastrados pelas pessoas da unidade (morador ou proprietário)."
    }
  ]
}